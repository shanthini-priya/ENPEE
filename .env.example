# ══════════════════════════════════════════════════════════════════════════════
# ENPEE International School CMS — Production Environment Configuration (.env)
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env in your cPanel app root and customize the values below.

# Environment Mode ('production' or 'development')
NODE_ENV=production

# Server Port or Passenger Socket
# On cPanel Phusion Passenger, PORT is automatically supplied (often as a Unix socket path or dynamic port).
# When running standalone or in testing, defaults to 3000.
PORT=3000

# Reverse Proxy Trust
# MUST be 'true' or '1' when running behind cPanel's Nginx/Apache reverse proxy and Phusion Passenger
# so secure session cookies and client IP addresses are resolved correctly.
TRUST_PROXY=true

# Public Production URL (Canonical Origin)
# Set this to your live domain with protocol (no trailing slash).
# Used for SEO canonical tags, sitemap.xml, robots.txt, and password reset links.
PUBLIC_ORIGIN=https://www.enpeekkl.com

# Session Encryption Key (CRITICAL)
# Secret key used for signing session tokens and hashing passwords.
# MUST be at least 32 characters long. Generate a strong random key before deploying!
SESSION_SECRET=replace_with_a_secure_random_key_of_at_least_32_characters_123456

# Initial Administrator Credentials
# Automatically seeds the admin user in the SQLite database if no admin exists yet.
ADMIN_EMAIL=admin@enpee.edu.in
ADMIN_PASSWORD=change_this_to_a_strong_password_2026

# SQLite Database File Path
# Relative or absolute path to SQLite file. The directory will be created automatically.
# In cPanel, default ./data/enpee.sqlite stores data inside your application directory.
DB_PATH=./data/enpee.sqlite

# Media Uploads Directory
# Folder where CMS image and video uploads are saved. Created automatically if missing.
UPLOAD_DIR=./uploads

# CORS Allowed Origins (Optional)
# Comma-separated origins if hosting frontend on a different domain or previewing via GitHub Pages.
# Example: https://shanthini-priya.github.io,https://enpeekkl.com
CORS_ORIGIN=

# ─── Optional: SMTP Email Settings (Password Resets & Enquiry Notifications) ──
# Configure these with your cPanel Webmail / SMTP credentials:
# SMTP_HOST=mail.enpeekkl.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=admissions@enpeekkl.com
# SMTP_PASS=your_cpanel_email_password
# SMTP_FROM="ENPEE International School" <admissions@enpeekkl.com>
